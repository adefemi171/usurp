# Copy to .env. Docker Compose reads this file automatically.

# ── Database ────────────────────────────────────────────────────────────────
# Inside compose, the host is the service name `postgres`. For the local dev
# loop (`npm run web`) against the compose database, use `localhost`.
DATABASE_URL=postgres://usurp:usurp@localhost:5433/usurp

POSTGRES_USER=usurp
POSTGRES_PASSWORD=usurp
POSTGRES_DB=usurp
POSTGRES_PORT=5433

# ── Web ─────────────────────────────────────────────────────────────────────
WEB_PORT=3000

# Public origin used in OAuth callback URLs. It must exactly match the origin
# registered with GitHub and Google.
USURP_BASE_URL=http://localhost:3000

# Required for OAuth. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Register callback: http://localhost:3000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Register callback: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Printed in `enroll` output so the code can be pasted straight into a CLI.
USURP_API_URL=http://localhost:3000

# ── CLI ─────────────────────────────────────────────────────────────────────
# Where `usurp sync` submits. Overridable per-invocation with `--api`.
# USURP_API_URL=https://usurp.example.com

# Device private key as a PKCS#8 PEM, for containers and CI where no OS
# keychain exists. Takes precedence over the keychain. Leave unset on a
# workstation — `usurp login` puts the key in the keychain instead.
# USURP_DEVICE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Optional same-host AgentsView bridge for owner-only browser refresh.
# Leave empty on a cloud deployment; upload from your local CLI instead.
USURP_AGENTS_VIEW_URL=
USURP_AGENTS_VIEW_DEVICE_ID=
