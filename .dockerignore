# Keep the build context small and the image reproducible: everything below is
# either regenerated inside the build or must never enter an image.
node_modules
**/node_modules
dist
**/dist
.next
**/.next
.next-qa
**/.next-qa
*.tsbuildinfo
**/*.tsbuildinfo

# Secrets and local state. `.env` is read by `docker compose` on the host, not
# baked into the image.
.env
.env.*
!.env.example
.migration-private

.git
.gitignore
coverage
*.log
README.md
SPEC.md
desktop

# Private operations and planning must not enter public application images.
deploy
docs
ROADMAP.md
spec.md
roadmap.md
scripts/mac-backup.test.ts
.claude
.codex
.agents
**/AGENTS.md
**/CLAUDE.md
backups
*.dump
*.dump.gpg
*.sql.gz
*.sql.gpg

# Only application/setup/test scripts belong in the build context.
scripts/*
!scripts/web.mjs
!scripts/render-demo.mjs
!scripts/render-demo.test.ts
!scripts/maintenance.mjs
!scripts/maintenance.test.ts
!scripts/database-endpoint-probe.mjs
!scripts/database-endpoint-probe.test.ts
!scripts/init-env.mjs
!scripts/init-env.test.ts
!scripts/http-smoke.mjs
!scripts/compose-smoke.mjs
