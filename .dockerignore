# Keep the build context small and the image reproducible: everything below is
# either regenerated inside the build or must never enter an image.
node_modules
**/node_modules
dist
**/dist
.next
**/.next
.next-qa
**/.next-qa
*.tsbuildinfo
**/*.tsbuildinfo

# Secrets and local state. `.env` is read by `docker compose` on the host, not
# baked into the image.
.env
.env.*
!.env.example
.migration-private

.git
.gitignore
coverage
*.log
README.md
SPEC.md
desktop

# Private operations and planning must not enter public application images.
deploy/database
docs
ROADMAP.md
spec.md
roadmap.md
scripts/mac-backup.test.ts
.claude
.codex
.agents
backups
*.dump
*.dump.gpg
*.sql.gz
*.sql.gpg
