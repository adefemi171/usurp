[Unit]
Description=Restore an encrypted Usurp backup into an isolated scratch database
After=docker.service
Requires=docker.service
OnFailure=usurp-db-backup-failed.service
[Service]
Type=oneshot
ExecStart=/opt/usurp-data/restore-check.sh
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
